<h2 id="{{review.page.fileSlug}}">{{review.data.gameTitle}}</h2>
<img src="pageassets/{{review.data.screenshot}}" />
<div class="sideblock">
    <p>
        {{review.data.summary}}
    </p>
    <dl class="stats-sideblock">
        <dt>Overall Score</dt>
        <dd>{{review.data.score}}/10</dd>
        <dt>Epiphany Strength</dt>
        <dd>{{review.data.epiphanyScore}}/10</dd>
        <dt>Length</dt>
        <dd>{{review.data.length}}</dd>
    </dl>
    <p>
        {% for link in review.data.gameLinks %}
        <a href="{{link.url}}">{{link.text}}</a>
        {% endfor %}
    </p>
</div>
{{ review.content }}
<ul class="proconlist">
    {% for item in review.data.proConList %}
    <li class="{{ item.class }}">{{item.value}}</li>
    {% endfor %}
</ul>